# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pool passcodes
SHARED_PASSCODE=office-passcode-everyone-uses
ADMIN_PASSCODE=admin-only-passcode

# API-Football (dashboard.api-football.com)
APIFOOTBALL_KEY=your-api-football-key

# Secret for the scheduled sync endpoint (any random string)
CRON_SECRET=any-long-random-string
